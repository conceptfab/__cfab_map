                 thumbnail_path: row.get(5)?,
+                thumbnail_data: None,
                 rbh: row.get(6)?,
                 value: row.get(7)?,
             })
         })
         .map_err(|e| e.to_string())?;
 
-    rows.collect::<Result<Vec<_>, _>>().map_err(|e| e.to_string())
+    let mut renders = rows.collect::<Result<Vec<_>, _>>().map_err(|e| e.to_string())?;
+    for render in &mut renders {
+        render.thumbnail_data = thumbnail_data_url(&render.thumbnail_path);
+    }
+    Ok(renders)
+}
+
+/// Sufit na jedną miniaturę; Hub zapisuje PNG o wysokości kilkuset px.
+const THUMBNAIL_MAX_BYTES: u64 = 4 * 1024 * 1024;
+
+/// Plik miniatury z Huba jako `data:` URL. `None`, gdy pliku nie ma (inna
+/// maszyna, wyczyszczony cache), nie jest obrazem albo jest za duży.
+fn thumbnail_data_url(path: &str) -> Option<String> {
+    use base64::Engine;
+
+    let path = std::path::Path::new(path.trim());
+    let ext = path.extension()?.to_str()?.to_ascii_lowercase();
+    let mime = match ext.as_str() {
+        "png" => "image/png",
+        "jpg" | "jpeg" => "image/jpeg",
+        "webp" => "image/webp",
+        _ => return None,
+    };
+    let meta = std::fs::metadata(path).ok()?;
+    if !meta.is_file() || meta.len() > THUMBNAIL_MAX_BYTES {
+        return None;
+    }
+    let bytes = std::fs::read(path).ok()?;
+    Some(format!(
+        "data:{mime};base64,{}",
+        base64::engine::general_purpose::STANDARD.encode(bytes)
+    ))
 }
 
