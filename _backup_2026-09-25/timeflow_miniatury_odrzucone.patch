+        // Pliku /thumb/shot1.jpg nie ma — raport pokazuje wiersz bez obrazka.
+        assert_eq!(renders[1].thumbnail_data, None);
+    }
+
+    #[test]
+    fn thumbnail_data_url_embeds_existing_image() {
+        let dir = std::env::temp_dir().join(format!("tf_thumb_{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let png = dir.join("shot.png");
+        std::fs::write(&png, [0x89, b'P', b'N', b'G']).unwrap();
+        let text = dir.join("shot.txt");
+        std::fs::write(&text, b"not an image").unwrap();
+
+        assert_eq!(
+            thumbnail_data_url(png.to_str().unwrap()).as_deref(),
+            Some("data:image/png;base64,iVBORw==")
+        );
+        assert_eq!(thumbnail_data_url(text.to_str().unwrap()), None);
+        assert_eq!(thumbnail_data_url(""), None);
+        assert_eq!(thumbnail_data_url(dir.join("missing.png").to_str().unwrap()), None);
+
+        std::fs::remove_dir_all(&dir).ok();
     }
 
