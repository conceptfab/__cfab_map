{
  "name": "cfab-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "data": "node scripts/build-data.mjs",
    "validate": "node scripts/validate.mjs",
    "prebuild": "npm run tokens && npm run data && npm run validate",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:vercel": "npm run validate && tsc --noEmit && vite build",
    "shot": "node scripts/shot.mjs"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-polygon": "^3.0.2",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-polygon": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
